#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: deploy-huddle-app <artifact-directory> <40-character-commit-sha>" >&2
  exit 64
fi

artifact_directory=$(cd "$1" && pwd)
release_sha=$2

if [[ ! "$release_sha" =~ ^[0-9a-f]{40}$ ]]; then
  echo "invalid release SHA: $release_sha" >&2
  exit 64
fi

release_root=${HUDDLE_RELEASE_ROOT:-/opt/huddle-app/releases}
current_link=${HUDDLE_CURRENT_LINK:-/opt/huddle-app/current}
database_path=${HUDDLE_DB_PATH:-/var/lib/huddle-app/when2meet.db}
backup_root=${HUDDLE_BACKUP_ROOT:-/var/backups/huddle-app}
service_name=${HUDDLE_SERVICE_NAME:-huddle-app.service}
readiness_url=${HUDDLE_READINESS_URL:-http://127.0.0.1:8000/readyz}
release_directory="$release_root/$release_sha"
archive="$artifact_directory/huddle-app-$release_sha.tar.gz"
checksum="$artifact_directory/huddle-app-$release_sha.sha256"

for required_file in "$archive" "$checksum"; do
  if [[ ! -f "$required_file" ]]; then
    echo "required artifact is missing: $required_file" >&2
    exit 66
  fi
done

mkdir -p "$release_root" "$backup_root"

if [[ -e "$release_directory" ]]; then
  echo "release already exists and is immutable: $release_directory" >&2
  exit 73
fi

(
  cd "$artifact_directory"
  sha256sum --check "$(basename "$checksum")"
)

temporary_release=$(mktemp -d "$release_root/.install-$release_sha-XXXXXX")
previous_release=""
service_stopped=false

cleanup() {
  if [[ -n "$temporary_release" && -d "$temporary_release" ]]; then
    rm -rf "$temporary_release"
  fi
}
trap cleanup EXIT

tar -xzf "$archive" -C "$temporary_release"

if [[ ! -f "$temporary_release/requirements.lock" ]]; then
  echo "release does not contain requirements.lock" >&2
  exit 65
fi

python3 -m venv "$temporary_release/.venv"
"$temporary_release/.venv/bin/python" -m pip install \
  --no-index \
  --find-links "$temporary_release/wheelhouse" \
  --requirement "$temporary_release/requirements.lock"

if [[ -L "$current_link" ]]; then
  previous_release=$(readlink -f "$current_link")
fi

if [[ -f "$database_path" ]]; then
  timestamp=$(date -u +%Y%m%dT%H%M%SZ)
  backup_path="$backup_root/when2meet-$timestamp-$release_sha.db"

  python3 - "$database_path" "$backup_path" <<'PY'
import sqlite3
import sys

source_path, backup_path = sys.argv[1:]
with sqlite3.connect(f"file:{source_path}?mode=ro", uri=True) as source:
    with sqlite3.connect(backup_path) as destination:
        source.backup(destination)
        result = destination.execute("PRAGMA integrity_check").fetchone()
        if result != ("ok",):
            raise RuntimeError(f"backup integrity check failed: {result}")
PY
  chmod 600 "$backup_path"
fi

if [[ -f "$temporary_release/scripts/migrate.py" ]]; then
  sudo --non-interactive systemctl stop "$service_name"
  service_stopped=true
  HUDDLE_DB_PATH="$database_path" \
    "$temporary_release/.venv/bin/python" \
    "$temporary_release/scripts/migrate.py"
fi

mv "$temporary_release" "$release_directory"
temporary_release=""

new_link="$current_link.new"
ln -sfn "$release_directory" "$new_link"
mv -Tf "$new_link" "$current_link"

sudo --non-interactive systemctl enable "$service_name"
if $service_stopped; then
  sudo --non-interactive systemctl start "$service_name"
else
  sudo --non-interactive systemctl restart "$service_name"
fi

ready=false
for _ in {1..30}; do
  if curl --fail --silent --show-error --max-time 2 "$readiness_url" >/dev/null; then
    ready=true
    break
  fi
  sleep 1
done

if ! $ready; then
  echo "new release failed readiness check; restoring previous code" >&2
  if [[ -n "$previous_release" && -d "$previous_release" ]]; then
    ln -sfn "$previous_release" "$new_link"
    mv -Tf "$new_link" "$current_link"
    sudo --non-interactive systemctl restart "$service_name"
    curl --fail --silent --show-error --max-time 5 "$readiness_url" >/dev/null ||
      echo "previous release also failed readiness; operator action required" >&2
  else
    sudo --non-interactive systemctl stop "$service_name"
    echo "there is no previous release to restore" >&2
  fi
  exit 1
fi

mapfile -t old_releases < <(
  ls -1dt "$release_root"/[0-9a-f]* 2>/dev/null | sed -n '4,$p'
)
for old_release in "${old_releases[@]}"; do
  [[ "$old_release" == "$release_directory" ]] || rm -rf "$old_release"
done

mapfile -t old_backups < <(
  ls -1t "$backup_root"/when2meet-*.db 2>/dev/null | sed -n '8,$p'
)
for old_backup in "${old_backups[@]}"; do
  rm -f "$old_backup"
done

echo "deployed $release_sha successfully"
