[Unit]
Description=Huddle App Lite
After=network.target

[Service]
Type=simple
User=huddle
Group=huddle
WorkingDirectory=/opt/huddle-app/current
Environment=HUDDLE_DB_PATH=/var/lib/huddle-app/when2meet.db
Environment=HUDDLE_HOST=127.0.0.1
Environment=HUDDLE_PORT=8000
ExecStart=/opt/huddle-app/current/.venv/bin/python -m app --host ${HUDDLE_HOST} --port ${HUDDLE_PORT}
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/huddle-app

[Install]
WantedBy=multi-user.target
